# Copy to .env only if you do not already have one. Never commit .env.
# For a NEW SQL instance, replace this placeholder with a strong unique password
# that satisfies SQL Server password policy. Keep the surrounding single quotes.
# For an EXISTING volume, use the CURRENT password; this does not rotate it.
MSSQL_SA_PASSWORD='REPLACE_WITH_YOUR_LOCAL_SQL_PASSWORD'

# If you move/rename a folder with existing Compose data, preserve its original
# project name to keep using the same volume. See README before setting this.
# COMPOSE_PROJECT_NAME=your_original_compose_project_name

# Compose reads this file. A separately launched .NET web app does NOT.
# Configure ConnectionStrings:DefaultConnection independently (see README).
