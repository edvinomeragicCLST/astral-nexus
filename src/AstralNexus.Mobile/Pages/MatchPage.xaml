<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AstralNexus.Mobile.Pages.MatchPage" Title="Simulator meča">
 <ScrollView><VerticalStackLayout Padding="14" Spacing="10"><Label Text="Simulator meča" Style="{StaticResource TitleLabel}"/><Picker x:Name="DeckPicker" Title="Odaberi validan špil" ItemDisplayBinding="{Binding Name}"/><Button x:Name="StartButton" Text="Pokreni meč" Clicked="Start_Clicked"/><VerticalStackLayout x:Name="GamePanel" IsVisible="False" Spacing="10"><Label x:Name="StatusLabel"/><Grid ColumnDefinitions="*,*"><Border Style="{StaticResource CardBorder}"><VerticalStackLayout><Label Text="Tvoj HP"/><Label x:Name="PlayerHpLabel" FontSize="26" FontAttributes="Bold"/><HorizontalStackLayout><Button Text="−" Clicked="PlayerMinus_Clicked"/><Button Text="+" Clicked="PlayerPlus_Clicked"/></HorizontalStackLayout></VerticalStackLayout></Border><Border Grid.Column="1" Style="{StaticResource CardBorder}"><VerticalStackLayout><Label Text="Protivnik HP"/><Label x:Name="OpponentHpLabel" FontSize="26" FontAttributes="Bold"/><HorizontalStackLayout><Button Text="−" Clicked="OpponentMinus_Clicked"/><Button Text="+" Clicked="OpponentPlus_Clicked"/></HorizontalStackLayout></VerticalStackLayout></Border></Grid><Label Text="Ruka" Style="{StaticResource SectionLabel}"/><CollectionView x:Name="HandView" HeightRequest="240"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardBorder}" WidthRequest="145"><VerticalStackLayout><Image Source="{Binding ImageFile}" HeightRequest="145" Aspect="AspectFit"/><Label Text="{Binding Name}" FontAttributes="Bold" FontSize="12"/><Button Text="Odbaci" CommandParameter="{Binding Id}" Clicked="Discard_Clicked" Padding="6,4"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><Grid ColumnDefinitions="*,*,*" ColumnSpacing="6"><Button Text="Izvuci" Clicked="Draw_Clicked"/><Button Grid.Column="1" Text="Kocka" Clicked="Dice_Clicked"/><Button Grid.Column="2" Text="Novčić" Clicked="Coin_Clicked"/></Grid><Button Text="Predaj potez" Clicked="EndTurn_Clicked"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Završi - pobjeda" Clicked="Win_Clicked"/><Button Grid.Column="1" Text="Završi - poraz" BackgroundColor="#A43D4C" Clicked="Loss_Clicked"/></Grid></VerticalStackLayout></VerticalStackLayout></ScrollView>
</ContentPage>
