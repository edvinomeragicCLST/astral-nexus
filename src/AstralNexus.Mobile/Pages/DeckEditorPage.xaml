<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AstralNexus.Mobile.Pages.DeckEditorPage" Title="Kreator špila">
 <Grid Padding="12" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8"><Entry x:Name="NameEntry" Placeholder="Naziv špila"/><Label Grid.Row="1" x:Name="CountLabel" FontAttributes="Bold"/><Label Grid.Row="2" Text="Pravila: 20 različitih karata; max 3 vrijednosti 3; max 8 Mage; max 1 Sentinel; max 5 Effect." FontSize="12"/><Grid Grid.Row="3" RowDefinitions="Auto,*,Auto,*" RowSpacing="6"><Label Text="Moja kolekcija" Style="{StaticResource SectionLabel}"/><CollectionView Grid.Row="1" x:Name="AvailableView" HeightRequest="250"><CollectionView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="60,*,Auto" Padding="3"><Image Source="{Binding ImageFile}" HeightRequest="54" WidthRequest="42" Aspect="AspectFit"/><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Name}" FontAttributes="Bold"/><Label Text="{Binding Meta}" FontSize="11"/></VerticalStackLayout><Button Grid.Column="2" Text="+" CommandParameter="{Binding Id}" Clicked="Add_Clicked" Padding="12,4"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView><Label Grid.Row="2" Text="Karte u špilu" Style="{StaticResource SectionLabel}"/><CollectionView Grid.Row="3" x:Name="SelectedView" HeightRequest="250"><CollectionView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Padding="4"><Label Text="{Binding Name}"/><Button Grid.Column="1" Text="−" CommandParameter="{Binding Id}" Clicked="Remove_Clicked" Padding="12,4" BackgroundColor="#A43D4C"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid><Button Grid.Row="4" Text="Sačuvaj špil" Clicked="Save_Clicked"/></Grid>
</ContentPage>
