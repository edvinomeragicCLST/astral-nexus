<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AstralNexus.Mobile.Pages.RegisterPage" Title="Registracija">
 <ScrollView><VerticalStackLayout Padding="24" Spacing="16"><Label Text="Novi korisnik" Style="{StaticResource TitleLabel}"/><Entry x:Name="NameEntry" Placeholder="Ime i prezime"/><Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email"/><Entry x:Name="PasswordEntry" Placeholder="Lozinka (min. 6 znakova)" IsPassword="True"/><Entry x:Name="ConfirmEntry" Placeholder="Ponovi lozinku" IsPassword="True"/><Label x:Name="ErrorLabel" TextColor="#D95050" IsVisible="False"/><Button Text="Kreiraj račun" Clicked="Register_Clicked"/></VerticalStackLayout></ScrollView>
</ContentPage>
