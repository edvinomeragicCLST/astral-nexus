<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AstralNexus.Mobile.Pages.DashboardPage" Title="Početna">
 <ScrollView><VerticalStackLayout Padding="18" Spacing="14"><Label x:Name="WelcomeLabel" Style="{StaticResource TitleLabel}"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10"><Border Style="{StaticResource CardBorder}"><VerticalStackLayout><Label Text="Coini"/><Label x:Name="CoinsLabel" FontSize="25" FontAttributes="Bold"/></VerticalStackLayout></Border><Border Grid.Column="1" Style="{StaticResource CardBorder}"><VerticalStackLayout><Label Text="Kolekcija"/><Label x:Name="CardsLabel" FontSize="25" FontAttributes="Bold"/></VerticalStackLayout></Border><Border Grid.Row="1" Style="{StaticResource CardBorder}"><VerticalStackLayout><Label Text="Špilovi"/><Label x:Name="DecksLabel" FontSize="25" FontAttributes="Bold"/></VerticalStackLayout></Border><Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}"><VerticalStackLayout><Label Text="Pobjede / porazi"/><Label x:Name="WinLossLabel" FontSize="22" FontAttributes="Bold"/></VerticalStackLayout></Border></Grid>
 <Label Text="Funkcionalnosti" Style="{StaticResource SectionLabel}"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10"><Button Text="Kolekcija" Clicked="Collection_Clicked"/><Button Grid.Column="1" Text="Moji špilovi" Clicked="Decks_Clicked"/><Button Grid.Row="1" Text="Otvori paket" Clicked="Shop_Clicked"/><Button Grid.Row="1" Grid.Column="1" Text="Simulator meča" Clicked="Match_Clicked"/><Button Grid.Row="2" Text="Historija" Clicked="History_Clicked"/><Button Grid.Row="2" Grid.Column="1" Text="Profil" Clicked="Profile_Clicked"/></Grid>
 <Button Text="Postavke" Style="{StaticResource SecondaryButton}" Clicked="Settings_Clicked"/><Button Text="Odjava" Style="{StaticResource SecondaryButton}" Clicked="Logout_Clicked"/></VerticalStackLayout></ScrollView>
</ContentPage>
