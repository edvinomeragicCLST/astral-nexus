<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AstralNexus.Mobile.Pages.SettingsPage" Title="Postavke">
 <ScrollView><VerticalStackLayout Padding="20" Spacing="14"><Label Text="Postavke" Style="{StaticResource TitleLabel}"/><Label Text="Tema aplikacije"/><Picker x:Name="ThemePicker"><Picker.Items><x:String>Sistem</x:String><x:String>Svijetla</x:String><x:String>Tamna</x:String></Picker.Items></Picker><Button Text="Primijeni temu" Clicked="ApplyTheme_Clicked"/><Label Text="REST sinhronizacija kataloga" Style="{StaticResource SectionLabel}"/><Label Text="Opcionalno: mobilna aplikacija može preuzeti ažurne podatke o kartama iz postojećeg ASP.NET Core projekta. Lokalni artwork i korisnički podaci ostaju u SQLite bazi."/><Entry x:Name="ApiEntry" Placeholder="npr. http://10.0.2.2:5092"/><Button Text="Sinhronizuj katalog" Clicked="Sync_Clicked"/><Label x:Name="SyncStatus" FontSize="12"/></VerticalStackLayout></ScrollView>
</ContentPage>
