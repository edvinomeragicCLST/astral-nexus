<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AstralNexus.Mobile.Pages.ShopPage" Title="Paketi karata">
 <ScrollView><VerticalStackLayout Padding="16" Spacing="14"><Image Source="box_art.png" HeightRequest="170" Aspect="AspectFit"/><Label Text="Otvori paket" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center"/><Label x:Name="CoinsLabel" HorizontalTextAlignment="Center" FontSize="20"/><Label Text="Paket košta 100 coina i sadrži 6 nasumičnih karata. Duplikat vraća 1 coin." HorizontalTextAlignment="Center"/><Button Text="Otvori paket (100)" Clicked="Open_Clicked"/><Label x:Name="ResultLabel" IsVisible="False" Style="{StaticResource SectionLabel}"/><CollectionView x:Name="ResultView" HeightRequest="360"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardBorder}" WidthRequest="160"><VerticalStackLayout><Image Source="{Binding Card.ImageFile}" HeightRequest="190" Aspect="AspectFit"/><Label Text="{Binding Card.Name}" FontAttributes="Bold"/><Label Text="{Binding DuplicateText}" FontSize="11"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></ScrollView>
</ContentPage>
