<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AstralNexus.Mobile.Pages.DecksPage" Title="Moji špilovi">
 <Grid Padding="14" RowDefinitions="Auto,*" RowSpacing="12"><Button Text="+ Novi špil" Clicked="New_Clicked"/><CollectionView Grid.Row="1" x:Name="DecksView"><CollectionView.EmptyView><Label Text="Još nema spremljenih špilova." HorizontalTextAlignment="Center" Margin="20"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardBorder}" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"><Label Text="{Binding Name}" FontSize="19" FontAttributes="Bold"/><Label Grid.Row="1" Text="{Binding StatusText}" FontSize="12"/><HorizontalStackLayout Grid.Column="1" Grid.RowSpan="2" Spacing="6"><Button Text="Uredi" CommandParameter="{Binding Id}" Clicked="Edit_Clicked" Padding="10,6"/><Button Text="Obriši" CommandParameter="{Binding Id}" Clicked="Delete_Clicked" Padding="10,6" BackgroundColor="#A43D4C"/></HorizontalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid>
</ContentPage>
