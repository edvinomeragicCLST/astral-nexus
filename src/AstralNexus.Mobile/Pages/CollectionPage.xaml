<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AstralNexus.Mobile.Pages.CollectionPage" Title="Kolekcija">
 <Grid Padding="12" RowDefinitions="Auto,Auto,*" RowSpacing="8"><SearchBar x:Name="Search" Placeholder="Pretraži karte..." TextChanged="Filter_Changed"/><Picker Grid.Row="1" x:Name="TypePicker" Title="Tip karte" SelectedIndexChanged="Filter_Changed"/><CollectionView Grid.Row="2" x:Name="CardsView"><CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardBorder}"><VerticalStackLayout Spacing="6"><Image Source="{Binding ImageFile}" HeightRequest="180" Aspect="AspectFit"/><Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation"/><Label Text="{Binding Meta}" FontSize="12"/><Label Text="{Binding QuantityText}" TextColor="{StaticResource Gold}" FontAttributes="Bold"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid>
</ContentPage>
